<%# O link do carrinho no cabeçalho. O id "cart_badge" é o alvo do Turbo Stream que
    atualiza o número quando algo é adicionado (cart_items/create.turbo_stream.erb). %>
<% count = current_cart&.items_count.to_i %>
<%= link_to cart_path, id: "cart_badge", class: "ml-auto flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100" do %>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
  </svg>
  Carrinho
  <span class="rounded-full bg-emerald-700 px-2 py-0.5 text-xs text-white" aria-label="<%= pluralize(count, "item", plural: "itens") %> no carrinho"><%= count %></span>
<% end %>

<% content_for :title, "Entrar" %>

<div class="mx-auto max-w-md">
  <h1 class="mb-6 text-2xl font-bold tracking-tight">Entrar</h1>

  <%# form_with gera sozinho o campo oculto authenticity_token (anti-CSRF). %>
  <%= form_with model: resource, scope: resource_name, url: session_path(resource_name), class: "card space-y-4" do |f| %>
    <div>
      <%= f.label :email, "E-mail", class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-input" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "form-label" %>
      <%# autocomplete: "current-password" deixa o gerenciador de senhas preencher. %>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: "form-input" %>
    </div>

    <%= f.submit "Entrar", class: "btn-primary w-full" %>
  <% end %>

  <%= render "users/shared/links" %>
</div>

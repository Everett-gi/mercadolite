<%# Erros de validação do formulário. data-turbo-temporary: o Turbo não guarda este bloco no
    cache da página (voltar no navegador não mostra erros antigos). %>
<% if resource.errors.any? %>
  <div class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert" data-turbo-temporary>
    <p class="font-medium">Não foi possível salvar:</p>
    <ul class="mt-1 list-disc pl-5">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

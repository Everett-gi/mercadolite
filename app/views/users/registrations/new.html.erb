<% content_for :title, "Criar conta" %>

<div class="mx-auto max-w-md">
  <h1 class="mb-6 text-2xl font-bold tracking-tight">Criar conta</h1>

  <%= form_with model: resource, scope: resource_name, url: registration_path(resource_name), class: "card space-y-4" do |f| %>
    <%= render "users/shared/error_messages", resource: %>

    <div>
      <%= f.label :email, "E-mail", class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-input" %>
      <p class="form-hint">Enviaremos um link para confirmar que o e-mail é seu.</p>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "form-label" %>
      <%# autocomplete: "new-password" pede ao navegador que SUGIRA uma senha forte. %>
      <%= f.password_field :password, autocomplete: "new-password", required: true,
            minlength: @minimum_password_length, class: "form-input" %>
      <p class="form-hint">
        No mínimo <%= @minimum_password_length %> caracteres. Uma frase com quatro palavras
        aleatórias é fácil de lembrar e difícil de adivinhar.
      </p>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirme a senha", class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "form-input" %>
    </div>

    <div class="flex items-start gap-2">
      <%= f.check_box :terms_of_service, class: "mt-1" %>
      <%= f.label :terms_of_service, class: "text-sm text-stone-700" do %>
        Li e aceito os <%= link_to "Termos de Uso", terms_path, target: "_blank", class: "text-emerald-700 underline" %>
        e a <%= link_to "Política de Privacidade", privacy_path, target: "_blank", class: "text-emerald-700 underline" %>.
      <% end %>
    </div>

    <%= f.submit "Criar conta", class: "btn-primary w-full" %>
  <% end %>

  <%= render "users/shared/links" %>
</div>

<% content_for :title, "Carrinho" %>

<h1 class="mb-6 text-2xl font-semibold">Seu carrinho</h1>

<% if @lines.empty? %>
  <div class="rounded-md border border-dashed border-stone-300 p-8 text-center text-stone-600">
    <p>Seu carrinho está vazio.</p>
    <p class="mt-2"><%= link_to "Ver os produtos", products_path, class: "text-emerald-700 underline" %></p>
  </div>
<% else %>
  <div class="grid gap-8 lg:grid-cols-[1fr_18rem]">
    <ul class="self-start divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
      <%= render partial: "carts/line", collection: @lines, as: :line %>
    </ul>

    <aside class="h-fit space-y-4 rounded-lg border border-stone-200 bg-white p-4">
      <div class="flex items-baseline justify-between">
        <span class="text-stone-600">Subtotal</span>
        <span class="text-xl font-semibold"><%= price_tag(@subtotal_cents) %></span>
      </div>
      <p class="text-xs text-stone-500">
        Preços conferidos agora, direto do catálogo. Itens indisponíveis ficam fora do subtotal.
      </p>
      <% if !@lines.all?(&:purchasable?) %>
        <p class="text-sm text-amber-700">Ajuste os itens indisponíveis acima para finalizar a compra.</p>
      <% elsif user_signed_in? %>
        <%# data-turbo=false: um envio normal do navegador. O Turbo envia formulários com
            fetch(), e o fetch tentaria seguir o redirecionamento para o Stripe: a CSP
            (connect-src 'self') barra, e o comprador ficaria parado no carrinho
            (conferido no Chromium). %>
        <%= button_to "Finalizar compra", checkout_path, method: :post,
              form: { data: { turbo: false } },
              class: "w-full rounded-md bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800" %>
        <p class="text-xs text-stone-500">
          Você vai para a página de pagamento do Stripe, em <strong>modo de teste</strong>: use o
          cartão 4242 4242 4242 4242, qualquer data futura e qualquer CVC.
        </p>
      <% else %>
        <%= link_to "Entre para finalizar a compra", new_user_session_path,
              class: "block w-full rounded-md bg-emerald-700 px-4 py-2 text-center text-sm font-medium text-white hover:bg-emerald-800" %>
        <p class="text-xs text-stone-500">O seu carrinho continua aqui depois do login.</p>
      <% end %>
    </aside>
  </div>
<% end %>

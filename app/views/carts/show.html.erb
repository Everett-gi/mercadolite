<% content_for :title, "Carrinho" %>

<h1 class="mb-6 text-2xl font-semibold">Seu carrinho</h1>

<% if @lines.empty? %>
  <div class="rounded-md border border-dashed border-stone-300 p-8 text-center text-stone-600">
    <p>Seu carrinho está vazio.</p>
    <p class="mt-2"><%= link_to "Ver os produtos", products_path, class: "text-emerald-700 underline" %></p>
  </div>
<% else %>
  <div class="grid gap-8 lg:grid-cols-[1fr_18rem]">
    <ul class="self-start divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
      <%= render partial: "carts/line", collection: @lines, as: :line %>
    </ul>

    <aside class="h-fit space-y-4 rounded-lg border border-stone-200 bg-white p-4">
      <div class="flex items-baseline justify-between">
        <span class="text-stone-600">Subtotal</span>
        <span class="text-xl font-semibold"><%= price_tag(@subtotal_cents) %></span>
      </div>
      <p class="text-xs text-stone-500">
        Preços conferidos agora, direto do catálogo. Itens indisponíveis ficam fora do subtotal.
      </p>
      <button type="button" disabled class="w-full cursor-not-allowed rounded-md bg-stone-300 px-4 py-2 text-sm font-medium text-stone-600">
        Finalizar compra
      </button>
      <p class="text-xs text-stone-500">O checkout (com login e Stripe em modo teste) chega na fase 3.</p>
    </aside>
  </div>
<% end %>

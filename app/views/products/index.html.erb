<% content_for :title, "Vitrine" %>

<div class="grid gap-8 lg:grid-cols-[16rem_1fr]">
  <%= render "filters", search: @search, vendors: @vendors %>

  <section aria-labelledby="resultados">
    <div class="mb-4 flex items-baseline justify-between">
      <h1 id="resultados" class="text-2xl font-semibold">Produtos</h1>
      <p class="text-sm text-stone-500">
        <%= pluralize(@pagination.total_count, "produto encontrado", plural: "produtos encontrados") %>
      </p>
    </div>

    <% if @search.errors.any? %>
      <div class="mb-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
        <p class="font-medium">Não foi possível aplicar os filtros:</p>
        <ul class="mt-1 list-inside list-disc">
          <% @search.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @products.any? %>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
        <%= render partial: "product", collection: @products %>
      </ul>
      <%= render "shared/pagination", pagination: @pagination, query: @search.to_params %>
    <% elsif @search.errors.none? %>
      <p class="rounded-md border border-dashed border-stone-300 p-8 text-center text-stone-500">
        Nenhum produto corresponde aos filtros.
      </p>
    <% end %>
  </section>
</div>

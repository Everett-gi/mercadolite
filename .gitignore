# Segredos (nunca versionar) — *.key cobre o config/master.key
.env
.env.*
!.env.example
*.key
*.pem

# Rails: dependências, logs, arquivos temporários e uploads locais
/.bundle
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/node_modules
/coverage

# Rails: CSS gerado pelo Tailwind (é recompilado a partir de app/assets/tailwind)
/app/assets/builds/*
!/app/assets/builds/.keep

# IDE / Sistema Operacional
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
